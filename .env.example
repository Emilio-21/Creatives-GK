# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo server-side, NUNCA con prefijo NEXT_PUBLIC

# ---- Cloudflare R2 ----
# Ninguna credencial de R2 lleva prefijo NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=creatives-dev

# Backup (Supabase → Project Settings → Database → Connection string → URI)
SUPABASE_DB_URL=

# Meta (fase 8) — el token es un System User token del Business Manager.
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# Secreto compartido con el worker del cron (workers/cron-sync): el mismo valor
# va en los secretos de los workers "relevo" y "creativos-gk-cron".
CRON_SECRET=

# Slack: Bot User OAuth Token de la app Relevo (docs/slack-app-manifest.yml).
SLACK_BOT_TOKEN=

# URL publica de la app, para los links de Slack. Sin ella usa la de produccion.
# APP_URL=http://localhost:3000
