{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "creativos-gk-cron",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": {
    // Cada 10 minutos: reintento de avisos de Slack que no salieron al momento.
    // Si cambias este, cambia SLACK_CRON en index.ts.
    //
    // Sync de Meta PAUSADO (2026-09-23): la cuenta de Meta esta en revision y
    // el sync diario llevaba desde el 16-sep fallando contra ella. Para
    // reactivarlo, agrega de vuelta "0 13 * * *" (diario 13:00 UTC).
    "crons": ["*/10 * * * *"]
  },
  "vars": {
    "APP_URL": "https://creativos-gk.growth-kingdom.workers.dev"
  }
}
