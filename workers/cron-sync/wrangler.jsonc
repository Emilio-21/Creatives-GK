{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "creativos-gk-cron",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "triggers": {
    // Cada 10 minutos: reintento de avisos de Slack que no salieron al momento.
    // Si cambias este, cambia SLACK_CRON en index.ts.
    //
    // Diario 13:00 UTC (7:00 en CDMX): sync de Meta. Estuvo pausado del 23-sep
    // al 3-oct mientras la cuenta de Meta estaba en revision.
    "crons": ["*/10 * * * *", "0 13 * * *"]
  },
  "vars": {
    "APP_URL": "https://relevo.growth-kingdom.workers.dev"
  }
}
